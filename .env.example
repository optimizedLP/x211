# Copy to .env.local and fill in. All three values are PUBLIC — they ship in the
# browser bundle by design, and row-level security is what protects the data.
#
# Never put the secret/service-role key (sb_secret_… / service_role) in a
# VITE_ variable: everything prefixed VITE_ is compiled into the bundle.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# The single shared account created in Supabase → Authentication → Users.
# Nobody types this address; people type its password, which is the access code.
VITE_ACCESS_EMAIL=access@your-school.org
